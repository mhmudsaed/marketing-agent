# LLM Configuration (OpenAI-compatible: llama.cpp, OpenRouter, vLLM)
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=
LLM_MODEL=qwen-3.6
LLM_TIMEOUT=120
LLM_DISABLE_THINKING=true
LLM_EXTRA_BODY={}

# Backwards-compatible OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Tavily Configuration
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=10
TAVILY_SEARCH_DEPTH=advanced

# SerpApi Configuration
SERPAPI_KEY=your_serpapi_key_here
SERPAPI_MAX_RESULTS=10
SERPAPI_LOCATION=
SERPAPI_GL=us
SERPAPI_HL=en

# Firecrawl Configuration
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Playwright / X Publishing
PLAYWRIGHT_USER_DATA_DIR=./outputs/playwright/x-profile
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO_MS=150
PLAYWRIGHT_DRY_RUN=false
PLAYWRIGHT_BROWSER_CHANNEL=
X_COMPOSE_URL=https://x.com/compose/post
X_LOGIN_URL=https://x.com/i/flow/login

# Pipeline Configuration
MAX_RESEARCH_DEPTH=3
MAX_OSINT_PAGES=8
MAX_CONTENT_VARIANTS=3
MAX_VERIFICATION_RETRIES=3
ENABLE_AUTO_PUBLISH=false
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO

# Content Configuration
DEFAULT_CALENDAR_DAYS=14
DEFAULT_POSTS_PER_WEEK=5
